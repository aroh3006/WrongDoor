<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>WrongDoor Report</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 2rem; color: #1a1a1a; background: #fff; }
  h1 { margin: 0; }
  .sub { color: #666; margin: 0 0 1.25rem; }
  .counts span { display: inline-block; padding: .25rem .6rem; border-radius: .4rem; margin-right: .5rem; font-size: .8rem; font-weight: 700; color: #fff; }
  .CRITICAL { background: #7f1d1d; } .HIGH { background: #b91c1c; } .MEDIUM { background: #b45309; } .LOW { background: #3f6212; }
  .card { border: 1px solid #e5e5e5; border-left: 5px solid #b91c1c; border-radius: .5rem; padding: 1rem 1.25rem; margin: 1rem 0; }
  .card h2 { margin: .2rem 0 .6rem; font-size: 1.05rem; }
  .badge { font-size: .68rem; padding: .12rem .45rem; border-radius: .35rem; vertical-align: middle; }
  .meta { color: #333; font-size: .9rem; margin: .3rem 0; }
  pre { background: #0f172a; color: #e2e8f0; padding: .75rem; border-radius: .4rem; overflow-x: auto; font-size: .85rem; }
  .fields code { background: #f1f5f9; padding: .1rem .35rem; border-radius: .3rem; margin-right: .3rem; }
  .rem { background: #f0fdf4; border: 1px solid #bbf7d0; padding: .6rem .8rem; border-radius: .4rem; }
  footer { color: #888; font-size: .8rem; margin-top: 2rem; }
</style>
</head>
<body>
  <h1>WrongDoor Report</h1>
  <p class="sub">{{ total }} confirmed finding{{ '' if total == 1 else 's' }} &middot; wrongdoor v{{ version }}</p>
  <div class="counts">
    {% for name, n in by_severity.items() %}{% if n %}<span class="{{ name }}">{{ name }}: {{ n }}</span>{% endif %}{% endfor %}
  </div>

  {% for f in findings %}
  <div class="card">
    <h2>{{ f.finding_type }} &middot; {{ f.method }} {{ f.operation_id }} <span class="badge {{ f.severity.name }}">{{ f.severity.name }}</span></h2>
    <p class="meta"><strong>actor:</strong> {{ f.actor }}{% if f.actor_tenant %} (tenant {{ f.actor_tenant }}){% endif %}
      &rarr; <strong>victim:</strong> {{ f.owner }}{% if f.owner_tenant %} (tenant {{ f.owner_tenant }}){% endif %} owns {{ f.resource_type }}/{{ f.object_id }}</p>
    <p class="meta">{{ f.explanation }}</p>
    <p class="meta"><strong>reproducible request pair:</strong></p>
    <pre>{{ f.canonical_request() }}
{{ f.attack_request() }}</pre>
    <p class="meta fields"><strong>body match:</strong> {% for field in f.matched_fields %}<code>{{ field }}</code>{% endfor %}</p>
    {% if include_bodies %}<p class="meta"><strong>observed body:</strong></p><pre>{{ f.judgment.observed.body }}</pre>{% endif %}
    <p class="rem"><strong>Remediation:</strong> {{ f.remediation }}</p>
  </div>
  {% endfor %}
  {% if total == 0 %}<p>No confirmed findings.</p>{% endif %}

  <footer>Sensitive report &mdash; handle accordingly. Response values are redacted unless generated with --include-bodies.</footer>
</body>
</html>
